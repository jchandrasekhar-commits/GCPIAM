        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "stackdriver",
            "uid": "${DS_GCM}"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "${gcp_project}",
            "filters": ["metric.type", "=", "kubernetes.io/container/cpu/core_usage_time"],
            "perSeriesAligner": "ALIGN_RATE",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "cloud-monitoring-auto",
            "groupBys": ["resource.label.namespace_name"]
          },
          "refId": "A"
        }
      ],
      "title": "Resource Utilization - Pod CPU by Namespace (vCPU)",
      "type": "timeseries"
