    {
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${DS_BQ}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "format": 0,
          "rawSql": "WITH src AS (\n  SELECT\n    TIMESTAMP_TRUNC(timestamp, MINUTE) AS time,\n    COALESCE(resource.labels.namespace_name, 'unknown') AS namespace,\n    IF(severity IN ('ERROR','CRITICAL','ALERT','EMERGENCY'), 1, 0) AS is_error\n  FROM `${project}.${dataset}.stdout_*`\n  WHERE _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MILLIS($__from)))\n    AND FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MILLIS($__to)))\n  UNION ALL\n  SELECT\n    TIMESTAMP_TRUNC(timestamp, MINUTE) AS time,\n    COALESCE(resource.labels.namespace_name, 'unknown') AS namespace,\n    1 AS is_error\n  FROM `${project}.${dataset}.stderr_*`\n  WHERE _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MILLIS($__from)))\n    AND FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MILLIS($__to)))\n)\nSELECT time, namespace AS metric, SAFE_DIVIDE(SUM(is_error), COUNT(1)) * 100 AS value\nFROM src\nGROUP BY time, metric\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Application Error Rate by Namespace (%)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${DS_BQ}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "format": 0,
          "rawSql": "SELECT\n  TIMESTAMP_TRUNC(timestamp, MINUTE) AS time,\n  COALESCE(resource.labels.namespace_name, 'unknown') AS metric,\n  COUNT(1) AS value\nFROM `${project}.${dataset}.stderr_*`\nWHERE _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MILLIS($__from)))\n  AND FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MILLIS($__to)))\n  AND (textPayload LIKE '%Back-off%' OR textPayload LIKE '%Restarting%' OR textPayload LIKE '%Restarted%' OR textPayload LIKE '%CrashLoopBackOff%')\nGROUP BY time, metric\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Pod Restart Counts by Namespace",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${DS_BQ}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "format": 0,
          "rawSql": "WITH latency AS (\n  SELECT\n    TIMESTAMP_TRUNC(timestamp, MINUTE) AS time,\n    SAFE_CAST(httpRequest.latency AS FLOAT64) * 1000 AS latency_ms\n  FROM `${project}.${dataset}.requests_*`\n  WHERE _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MILLIS($__from)))\n    AND FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MILLIS($__to)))\n    AND httpRequest.latency IS NOT NULL\n), q AS (\n  SELECT\n    time,\n    APPROX_QUANTILES(latency_ms, 100) AS p\n  FROM latency\n  WHERE latency_ms IS NOT NULL\n  GROUP BY time\n)\nSELECT time, 'p50 (Median)' AS metric, p[OFFSET(50)] AS value FROM q\nUNION ALL\nSELECT time, 'p95 (Degraded)' AS metric, p[OFFSET(95)] AS value FROM q\nUNION ALL\nSELECT time, 'p99 (Outliers)' AS metric, p[OFFSET(99)] AS value FROM q\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Request Latency Percentiles (p50/p95/p99) - LB (ms)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
