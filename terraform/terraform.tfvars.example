# Copy to terraform.tfvars and fill in real values, then run:
#   terraform apply
# Do NOT commit a real terraform.tfvars containing secrets.

# --- Required ---------------------------------------------------------------
project_id = "project-pubsub-32009"
region     = "us-central1"

# --- BigQuery ---------------------------------------------------------------
bq_dataset = "logs_dataset_us"

# --- Secret Manager (override; do not commit real secrets) ------------------
# app_secret_value = "your-real-secret"

# --- Secondary (DR) cluster: on by default to satisfy the two-cluster req ----
enable_secondary         = true
secondary_region         = "us-east1"
secondary_node_locations = ["us-east1-b", "us-east1-c"]
secondary_subnet_cidr    = "10.20.0.0/20"

# --- Multi-Cluster Ingress + Multi-Cluster Services (global LB, failover) ----
# Requires enable_secondary = true. Registers both clusters into a GKE Fleet and
# enables MCI/MCS. After apply, run scripts/deploy-multicluster.ps1.
enable_multicluster_ingress = false

# --- Private cluster hardening ----------------------------------------------
enable_private_nodes = true
# Restrict control-plane access to your admin IP in production, e.g.:
# master_authorized_cidrs = [
#   { cidr_block = "203.0.113.10/32", display_name = "admin-laptop" }
# ]
# Replace with your admin workstation public IP or VPN egress CIDR. Never use 0.0.0.0/0.
# Leave as [] to fully lock the endpoint (access only via Cloud Shell or bastion host).
master_authorized_cidrs = [
  { cidr_block = "203.0.113.0/32", display_name = "admin-workstation" }
]

# --- IAM principals (defaults are empty; must be set explicitly) -------------
# Use group: principals so team membership is managed in your IdP, not here.
dev_principals       = ["group:dev-team@your-domain.com"]
ops_principals       = ["group:ops-team@your-domain.com"]
sre_principals       = ["group:sre-team@your-domain.com"]
cicd_user_principals = ["user:cicd-admin@your-domain.com"]

# --- Load balancer / DNS / security -----------------------------------------
# Binary Authorization: on by default. Set false only for images without attestation.
enable_binary_authorization = true

# Cloud DNS: set true only if you own the domain below.
enable_cloud_dns = false
dns_domain       = "example.com."      # trailing dot; e.g. "yourapp.com."
app_hostname     = "app.example.com"   # must match k8s ManagedCertificate + Ingress host

# Uptime alerting: set an email to create a notification channel + alert policy.
uptime_alert_email = ""

# --- Web App B backing services (Cloud SQL HA + Memorystore + Pub/Sub) -------
# Off by default to stay in the free tier. Enabling provisions a regional (HA)
# Cloud SQL instance with automated backups/PITR, a Memorystore Redis HA cache,
# and a Pub/Sub topic + subscription.
enable_stateful_services = false
# db_password = "set-a-real-password-here"
